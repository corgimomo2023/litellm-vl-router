# Copy to .env, replace every change-me value, then add provider keys.
# Keep LITELLM_SALT_KEY stable after first startup or encrypted DB credentials become unreadable.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me-use-openssl-rand-hex-32
LITELLM_SALT_KEY=change-me-use-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
REDIS_PASSWORD=change-me-use-openssl-rand-hex-32

# DeepSeek native/OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=openai/deepseek-v4-flash
DEEPSEEK_PRO_MODEL=openai/deepseek-v4-pro

# Qwen OpenAI-compatible endpoint. Change the API base for your Alibaba region.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=openai/qwen3.5-flash
