# Copy to .env and replace every change-me/replace-me placeholder.
# Keep LITELLM_SALT_KEY stable after first startup or encrypted DB data becomes unreadable.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-change-me-master-key
LITELLM_SALT_KEY=change-me-use-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
REDIS_PASSWORD=change-me-use-openssl-rand-hex-32

# Safety switch used by scripts/smoke.sh. Keep true while upstream values are placeholders.
PLACEHOLDER_MODE=true

# OpenCode Go OpenAI-compatible text/code backend (DeepSeek V4 Flash internally).
OPENCODE_GO_API_KEY=change-me-opencode-go-key
OPENCODE_GO_API_BASE=https://replace-me-opencode-go.invalid/v1
OPENCODE_GO_MODEL=openai/replace-me-deepseek-v4-flash

# GPT Luna OpenAI-compatible vision backend.
GPT_LUNA_API_KEY=change-me-gpt-luna-key
GPT_LUNA_API_BASE=https://replace-me-gpt-luna.invalid/v1
GPT_LUNA_MODEL=openai/replace-me-gpt-luna-vision
